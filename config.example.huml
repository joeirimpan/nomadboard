# Nomad Job Status - Example Configuration
#
# Copy this file to config.huml and edit to match your setup.

# Display name shown in the UI header and page titles.
# Defaults to "Nomad Pulse" if omitted.
name: "Nomad Pulse"

# Nomad cluster endpoints. One entry per datacenter.
# token_env is optional - omit for clusters without ACLs.
clusters::
  - ::
    name: "dc1"
    address: "http://localhost:4646"
    token_env: "NOMAD_TOKEN"

# How often to poll Nomad clusters (seconds).
poll_interval: 30

# Restart detection uses two windows:
#   restart_window       - display window: restarts within this period are shown in the UI (default: 24h)
#   restart_alert_window - alert window: only restarts within this shorter period affect health (default: 30m)
#
# This avoids planned BOD restarts (e.g. at 8 AM) showing as unhealthy by 9 AM.
#
# Thresholds (applied to the alert window count):
#   >= restart_warn -> yellow warning
#   >= restart_crit -> red critical
# Maximum jobs per page in group view.
per_page: 20

# Mask IP-like suffixes in node names (4 dash-separated numeric segments).
# e.g. "myapp-aux-10-0-1-5" → "myapp-aux-***"
mask_node_ip: false

restart_window: "24h"
restart_alert_window: "30m"
restart_warn: 1
restart_crit: 5

# How often to send a keepalive comment on idle SSE streams (seconds).
# Must be lower than the idle timeout of any proxy in front of the server
# (e.g. HAProxy `timeout client`), otherwise live updates get cut and the
# browser reconnects in a loop. Default: 5
sse_keepalive: 5

# HTTP listen address.
listen: ":9999"

# Service groups. Logical grouping of jobs for the dashboard.
# Glob patterns are supported in job names (e.g. "api-*").
groups::
  - ::
    name: "My App"
    namespace: "default"
    priority: 1
    jobs::
      - "web-frontend"
      - "api-server"
      - "worker-*"
    # External links rendered as icon buttons per job.
    # URL is a Go template: [[.Group]], [[.Job]], [[.Namespace]], [[.DC]],
    #   [[.Var.<key>]] (cluster vars), [[.Meta.<key>]] (per-job metadata).
    # icon can be an image URL (http/https) or an emoji string.
    # meta keys are job patterns (globs supported). Exact match beats glob.
    # A job only gets the link if it matches a meta key.
    links::
      - ::
        label: "Grafana"
        icon: "https://grafana.com/static/img/menu/grafana2.svg"
        url: "https://grafana.internal/d/[[.Meta.dashboard]]?var-job=[[.Job]]"
        meta::
          "web-frontend"::
            dashboard: "web/web-frontend"
          "api-server"::
            dashboard: "api/api-server"
          "worker-*"::
            dashboard: "workers/worker-overview"
      - ::
        label: "Logs"
        icon: "https://logchef.app/logo.svg"
        url: "https://logchef.internal/sources/[[.Meta.source_id]]/search"
        meta::
          "web-frontend"::
            source_id: "src-web"
          "api-server"::
            source_id: "src-api"
  - ::
    name: "Infrastructure"
    namespace: "infra"
    priority: 10
    jobs::
      - "consul-*"
      - "vault-*"
  # Groups can span multiple namespaces. Use "namespaces" (plural) to list them.
  # Jobs with the same name in different namespaces are shown separately.
  # - ::
  #   name: "Monitoring"
  #   namespaces::
  #     - "infra"
  #     - "platform"
  #   jobs::
  #     - "vmagent"
